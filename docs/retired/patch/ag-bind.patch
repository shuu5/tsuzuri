+/// 札 `spec` の `agent_id` に係の id を書いて `<名>/spec.json` に書き、`.agents/<係の id>` に名を書く。
+pub fn tie(dir: &Path, name: &str, spec: &mut Spec, id: &str) -> io::Result<()> {
+    spec.agent_id = Some(id.to_string());
+    fs::write(dir.join(name).join(SPEC), spec.render())
