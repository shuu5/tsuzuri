+    Button,
+}
+
+impl Word for Starter {
+    const ALL: &'static [Self] = &[Starter::Seat, Starter::Chat, Starter::Button];
+    fn word(self) -> &'static str {
+        match self {
+            Starter::Seat => "席",
+            Starter::Chat => "持ち主のチャット",
+            Starter::Button => "持ち主の button",
+        }
+    }
+}
