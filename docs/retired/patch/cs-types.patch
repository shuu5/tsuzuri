+#[serde(rename_all = "kebab-case")]
+pub enum Verdict {
+    Adopt,
+    Partial,
+    Reject,
+}
+
+impl Word for Verdict {
+    const ALL: &'static [Self] = &[Verdict::Adopt, Verdict::Partial, Verdict::Reject];
+    fn word(self) -> &'static str {
