+    Watch,
+    Done,
+    Hook,
+    List,
+}
+
+impl Word for Via {
+    const ALL: &'static [Self] = &[Via::Watch, Via::Done, Via::Hook, Via::List];
+    fn word(self) -> &'static str {
+        match self {
+            Via::Watch => "見張り",
+            Via::Done => "完了",
+            Via::Hook => "hook",
+            Via::List => "一覧",
+        }
+    }
+}
