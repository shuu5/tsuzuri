+
+/// 所見の候補の 1 つ。
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct FindingOption {
+    pub id: String,
+    pub name: String,
+    pub text: String,
+    pub verdict: Adoption,
+    pub reason: String,
+}
+
+/// 主張の 1 つと確かさ。
