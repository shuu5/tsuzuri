+/// 短い題を上限の字数に切る（`SHORT_MAX` 字以下ならそのまま・越えれば頭の `SHORT_MAX` − 1 字と `ELLIPSIS` の `SHORT_MAX` 字）。
+pub fn capped(short: &str) -> String {
+    if short.chars().count() <= SHORT_MAX {
+        return short.to_string();
+    }
+    short
+        .chars()
+        .take(SHORT_MAX - 1)
+        .chain([ELLIPSIS])
