-/// 台帳のほかの組と ~run（親の無い・親をたどって帯に着かない節点の置き場）。
-fn loose<'g>(kind: NodeKind) -> Up<'g> {
-    match kind {
-        NodeKind::Run => Up::Group("~run".into(), kind),
-        _ => Up::Group(format!("~led:{}", word(kind)), kind),
-    }
