-/// 条の系（id の頭の ASCII の英字の並び・無ければ _）。
-fn series(id: &str) -> &str {
-    let end = id
-        .bytes()
-        .position(|c| !c.is_ascii_alphabetic())
-        .unwrap_or(id.len());
-    if end == 0 { "_" } else { &id[..end] }
-}
