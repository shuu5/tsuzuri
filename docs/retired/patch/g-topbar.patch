+        .into_any()
+    }
+
+    fn use_view(u: Use) -> AnyView {
+        let pct = u.used.map_or_else(|| "?".to_string(), |p| format!("{p}%"));
+        view! {
+            <span class="ub">
+                <em>{u.short}</em>
