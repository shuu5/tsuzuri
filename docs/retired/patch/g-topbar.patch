+
+    fn notice_view(line: NoticeLine, wins: WinCtx<Win>) -> AnyView {
+        view! {
+            <button type="button" class="notice" aria-label=label("notice") on:click=move |_| wins.open(Win::Notices, false)>
+                <span inner_html=MEGA></span>
+                <time>{line.when}</time>
