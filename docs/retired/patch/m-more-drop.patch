+/// fixture の 5 組（組の名 → 電文の型）。
+fn fixture() -> BTreeMap<String, SeatCard> {
+    wire::decode(&read("../../tests/fixtures/surface/seat-card.json"))
+        .expect("fixture の組が電文として読める")
+}
