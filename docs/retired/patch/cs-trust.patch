+    let fresh = "{\n  \"projects\": {\n    \"/W\": {\n      \"hasTrustDialogAccepted\": true\n    }\n  }\n}\n";
+    assert_eq!(trusted(None, "/W"), Ok(Some(fresh.to_string())));
