+        SeatConstitution::Declared(path) => Outcome::ok_line(format!("seat-constitution {path}")),
+        SeatConstitution::Absent => Outcome::failed(RC_REFUSED, vec!["vessel: 宣言に seat-constitution が無い".to_owned()]),
