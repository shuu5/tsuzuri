+
+    /// 名乗った写しが無い周は、写しの代わりに path と理由と次の 1 手を名指す 1 行を出し、その後ろは役割の 7 行で、5 行へ戻さない。
+    #[test]
+    fn vbconst_missing_copy_names_the_path_and_the_next_step() {
+        let root = scratch("vbconst-missing");
