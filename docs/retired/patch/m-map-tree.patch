-/// 項を前から順にたどった (深さ・名・open・kids の数) の列。
-fn outline(item: &Branch) -> Vec<(usize, String, bool, usize)> {
-    fn go(b: &Branch, depth: usize, out: &mut Vec<(usize, String, bool, usize)>) {
-        out.push((depth, name(&b.head), b.open, b.kids.len()));
-        for k in &b.kids {
-            go(k, depth + 1, out);
-        }
-    }
-    let mut out = Vec::new();
-    go(item, 0, &mut out);
-    out
-}
