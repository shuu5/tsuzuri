+
+/// repo の根（xtask の manifest の dir の 1 つ上）からの相対の path の file を読む。
+pub(crate) fn read_root(rel: &str) -> String {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("..")
