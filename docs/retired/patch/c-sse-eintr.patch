 /// GET を 1 つ撃ち、（状態の code・本文）を返す。
 fn get(addr: SocketAddr, path: &str) -> (u16, String) {
     let mut s = TcpStream::connect(addr).expect("接続");
@@ -580,7 +593,7 @@ fn pmisfit_sse_arms_and_tells() {
