diff --git a/crates/tsuzuri-boundary/tests/aghk.rs b/crates/tsuzuri-boundary/tests/aghk.rs
new file mode 100644
index 00000000..00ff6432
--- /dev/null
+++ b/crates/tsuzuri-boundary/tests/aghk.rs
@@ -0,0 +1,223 @@
+//! 係の起こしの門と結びの口の歯（接頭辞 aghk_・設計ノート surface-wave29b 行 ag-spec・判断の記録 ADR-59 決定 (1)(2)(4)）。
+//! tz の binary の tz hook agent-spawn と agent-bind に、係の試しの門の入力の形（会話の id と path は伏せた）を標準入力で渡し、
+//! 歯ごとの置き場（CARGO_TARGET_TMPDIR の下）の drafts/ を --drafts で渡す（本物の起草の置き場と git config は読まない）。
+#![cfg(test)]
+
+use std::fs;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output, Stdio};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+/// 頼み（JSON の字の中の形・頭の 4 行と空の行と本文）。
+const PROMPT: &str = r"予算: token 250000\n組み: なし\n対象: t3-hub.87\n出す物: notes.md,apply.py\n\n行 ag-spec を起草する。";
+
+/// 係の呼びの頭の欄（試しの係の id の形）。
+const SUB: &str = r#""agent_id":"aa21461fe66d86b69","agent_type":"tsuzuri:drafter","#;
+
+/// 歯ごとの置き場（前の撃ちの残りを消して作る）と、その下の空の drafts/。
+fn place(name: &str) -> (PathBuf, PathBuf) {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join("aghk")
+        .join(name);
+    let _ = fs::remove_dir_all(&root);
+    let drafts = root.join("drafts");
+    fs::create_dir_all(&drafts).unwrap();
+    (root, drafts)
+}
+
+/// tz hook <verb> --repo <root> --drafts <drafts> に `input` を渡した結果。
+fn hook(verb: &str, root: &Path, input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_tz"))
+        .args(["hook", verb, "--repo"])
+        .arg(root)
+        .arg("--drafts")
+        .arg(root.join("drafts"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let _ = child.stdin.take().unwrap().write_all(input.as_bytes());
+    child.wait_with_output().unwrap()
+}
+
+/// 門の入力（`head` は頭の欄の足し・`tail` は末の欄の足し）。
+fn input(event: &str, head: &str, tool: &str, tool_input: &str, tail: &str) -> String {
+    format!(
+        r#"{{"session_id":"00000000-0000-4000-8000-000000000000","transcript_path":"/T/s.jsonl","cwd":"/W","permission_mode":"bypassPermissions",{head}"hook_event_name":"{event}","tool_name":"{tool}","tool_input":{tool_input},"tool_use_id":"toolu_X"{tail}}}"#
+    )
+}
+
+/// Agent の tool_input（`name` は名の欄の足し）。
+fn agent(kind: &str, name: &str) -> String {
+    format!(
+        r#"{{"description":"起草","prompt":"{PROMPT}","subagent_type":"{kind}","run_in_background":true{name}}}"#
+    )
+}
+
+/// 席の起こしの入力（型 tsuzuri:drafter・名 w208a）。
+fn spawn_in(head: &str) -> String {
+    let name = r#","name":"w208a""#;
+    input(
+        "PreToolUse",
+        head,
+        "Agent",
+        &agent("tsuzuri:drafter", name),
+        "",
+    )
+}
+
+/// 起こしの結果の入力（`response` は tool_response の中身）。
+fn bind_in(head: &str, response: &str) -> String {
+    let tail = format!(r#","tool_response":{{"status":"async_launched"{response}}}"#);
+    let name = r#","name":"w208a""#;
+    input(
+        "PostToolUse",
+        head,
+        "Agent",
+        &agent("tsuzuri:drafter", name),
+        &tail,
+    )
+}
+
+/// 置き場の下の file の名の列（並べた相対の path）。
+fn tree(dir: &Path) -> Vec<String> {
+    let mut out = Vec::new();
+    for e in fs::read_dir(dir).unwrap().flatten() {
+        let p = e.path();
+        if p.is_dir() {
+            out.extend(tree(&p));
+        } else {
+            out.push(p.display().to_string());
+        }
+    }
+    out.sort();
+    out
+}
+
+/// 何も出さず何も書かない rc 0 の撃ち。
+fn silent(out: &Output, drafts: &Path, what: &str) {
+    assert_eq!(out.status.code(), Some(0), "{what}");
+    assert!(out.stdout.is_empty(), "{what}");
+    assert!(tree(drafts).is_empty(), "{what}");
+}
+
+/// 係の id の在る入力は起こしの門と結びの口の両方で rc 0・出力なし・何も書かない（型の外の Agent の呼びでも見ない）。Agent でない道具も同じ。
+#[test]
+fn aghk_agent_calls_and_other_tools_pass_silently() {
+    let (root, drafts) = place("silent");
+    let probe = input("PreToolUse", SUB, "Agent", &agent("tryp:probe", ""), "");
+    silent(&hook("agent-spawn", &root, &probe), &drafts, "係の起こし");
+    let bash = input("PreToolUse", "", "Bash", r#"{"command":"ls"}"#, "");
+    silent(&hook("agent-spawn", &root, &bash), &drafts, "席の Bash");
+    let bound = bind_in(SUB, r#","agentId":"a9f""#);
+    silent(&hook("agent-bind", &root, &bound), &drafts, "係の結び");
+    silent(&hook("agent-bind", &root, &bash), &drafts, "結びの Bash");
+    let seat = input("PreToolUse", "", "Agent", &agent("tryp:probe", ""), "");
+    let out = hook("agent-spawn", &root, &seat);
+    assert!(String::from_utf8_lossy(&out.stdout).contains(r#""permissionDecision":"deny""#));
+}
+
+/// 型が tsuzuri の 3 本でない席の Agent の呼びを断り、断りの字に 3 本の名が在る。名の無い呼びを断る。断る時は何も書かない。
+#[test]
+fn aghk_spawn_refuses_a_type_outside_the_three_and_a_missing_name() {
+    let (root, drafts) = place("refuse");
+    let name = r#","name":"w208a""#;
+    let probe = input("PreToolUse", "", "Agent", &agent("tryp:probe", name), "");
+    let out = hook("agent-spawn", &root, &probe);
+    let text = String::from_utf8_lossy(&out.stdout).into_owned();
+    assert_eq!(out.status.code(), Some(0));
+    assert!(text.contains(r#""permissionDecision":"deny""#), "{text}");
+    for kind in ["tsuzuri:drafter", "tsuzuri:verifier", "tsuzuri:researcher"] {
+        assert!(text.contains(kind), "{kind} {text}");
+    }
+    let nameless = input("PreToolUse", "", "Agent", &agent("tsuzuri:drafter", ""), "");
+    let text = String::from_utf8_lossy(&hook("agent-spawn", &root, &nameless).stdout).into_owned();
+    assert!(text.contains(r#""permissionDecision":"deny""#), "{text}");
+    assert!(text.contains("名が無いか"), "{text}");
+    assert!(tree(&drafts).is_empty());
+}
+
+/// 通した呼びは何も出さず、brief.md に prompt の字を、spec.json に名・型・4 つの値・起こしの時刻を書く。
+/// 続けて同じ対象の別の名の起こしは、生きた札との重なりで断る。
+#[test]
+fn aghk_spawn_writes_the_brief_and_the_spec() {
+    let (root, drafts) = place("write");
+    let before = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    let out = hook("agent-spawn", &root, &spawn_in(""));
+    let after = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    assert_eq!(
+        (out.status.code(), out.stdout.as_slice()),
+        (Some(0), &b""[..])
+    );
+    let brief = fs::read_to_string(drafts.join("w208a/brief.md")).unwrap();
+    assert_eq!(brief, PROMPT.replace(r"\n", "\n"));
+    let spec = fs::read_to_string(drafts.join("w208a/spec.json")).unwrap();
+    for field in [
+        r#""name": "w208a""#,
+        r#""type": "tsuzuri:drafter""#,
+        r#""budget": 250000"#,
+        r#""build": "なし""#,
+        r#""target": "t3-hub.87""#,
+        "\"outputs\": [\n    \"notes.md\",\n    \"apply.py\"\n  ]",
+        r#""agent_id": null"#,
+        r#""ended": null"#,
+    ] {
+        assert!(spec.contains(field), "{field} {spec}");
+    }
+    let spawned: u64 = spec
+        .split("\"spawned\": ")
+        .nth(1)
+        .unwrap()
+        .split(',')
+        .next()
+        .unwrap()
+        .parse()
+        .unwrap();
+    assert!((before..=after).contains(&spawned), "{spawned}");
+    let other = spawn_in("").replace(r#""name":"w208a""#, r#""name":"w208b""#);
+    let text = String::from_utf8_lossy(&hook("agent-spawn", &root, &other).stdout).into_owned();
+    assert!(
+        text.contains("生きた係 w208a が同じ対象 t3-hub.87 を持つ"),
+        "{text}"
+    );
+    assert!(!drafts.join("w208b").exists());
+}
+
+/// 結びの口は agentId の無い結果では何も書かず、在る結果では spec.json の agent_id と .agents/<agentId> の名を書く。
+#[test]
+fn aghk_bind_writes_the_agent_id_and_skips_a_response_without_it() {
+    let (root, drafts) = place("bind");
+    assert_eq!(
+        hook("agent-spawn", &root, &spawn_in("")).status.code(),
+        Some(0)
+    );
+    let spec_file = drafts.join("w208a/spec.json");
+    let spec = fs::read_to_string(&spec_file).unwrap();
+    let out = hook("agent-bind", &root, &bind_in("", ""));
+    assert_eq!(
+        (out.status.code(), out.stdout.as_slice()),
+        (Some(0), &b""[..])
+    );
+    assert_eq!(fs::read_to_string(&spec_file).unwrap(), spec);
+    assert!(!drafts.join(".agents").exists());
+    let out = hook("agent-bind", &root, &bind_in("", r#","agentId":"a9f0c1""#));
+    assert_eq!(
+        (out.status.code(), out.stdout.as_slice()),
+        (Some(0), &b""[..])
+    );
+    let bound = fs::read_to_string(&spec_file).unwrap();
+    assert_eq!(
+        bound,
+        spec.replace(r#""agent_id": null"#, r#""agent_id": "a9f0c1""#)
+    );
+    let name = fs::read_to_string(drafts.join(".agents/a9f0c1")).unwrap();
+    assert_eq!(name, "w208a\n");
+}
