+/// (e) 条の規範文の一覧（無い・null は空・一覧でなければ Err）。
+fn statements_of<'a>(a: &'a Value, f: &str) -> Result<&'a [Value], String> {
+    Ok(match a.get(f) {
+        None | Some(Value::Null) => &[],
+        Some(Value::Seq(items)) => items,
+        Some(_) => {
