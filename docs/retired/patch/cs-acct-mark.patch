+#[serde(deny_unknown_fields)]
+pub struct Stamp {
+    /// 足した時刻（UTC の epoch 秒）。
+    pub at: EpochSecs,
+    pub event: StampEvent,
+    /// 会話の id（uuid の形）。
+    pub sid: String,
+    /// 会話の始まりの種類（SessionStart の source・ほかの事は None）。
+    pub source: Option<String>,
 }
