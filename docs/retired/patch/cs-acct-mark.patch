+impl StampEvent {
+    /// hook の名（`hook_event_name` の字）から読む（ほかの名は None）。
+    pub fn of_hook(name: &str) -> Option<Self> {
+        match name {
+            "SessionStart" => Some(StampEvent::Start),
+            "UserPromptSubmit" => Some(StampEvent::Prompt),
+            "Stop" => Some(StampEvent::Stop),
+            _ => None,
+        }
+    }
+}
