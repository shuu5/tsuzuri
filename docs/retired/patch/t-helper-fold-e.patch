+pub(crate) fn folio_face(face: &str, dir: &Path, out: &Path, mode: &str) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_tz"))
+        .arg("face")
+        .arg("--face")
+        .arg(face)
+        .arg("--dir")
+        .arg(dir)
+        .arg("--out")
+        .arg(out)
+        .arg(mode)
+        .output()
+        .expect("folio を起動できない")
+}
