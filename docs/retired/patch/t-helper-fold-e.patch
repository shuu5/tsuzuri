+pub(crate) fn edit(path: &Path, f: impl FnOnce(&str) -> String) {
+    let before = fs::read_to_string(path).unwrap();
+    let after = f(&before);
+    assert_ne!(before, after, "変異が当たっていない: {}", path.display());
+    fs::write(path, after).unwrap();
+}
