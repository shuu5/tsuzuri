+/// 入口の面で、fixture の写しに変異を 1 つ当て、`--write` = 2 ∧「まだ分からない」∧ 出力先が出来ていない。
+pub(crate) fn index_unknown(case: &str, mutate: impl FnOnce(&Path)) {
+    index_unknown_from(
+        index_fixture_copy(&format!("index-unknown-{case}")),
