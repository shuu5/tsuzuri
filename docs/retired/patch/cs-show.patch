+/// 所見を、添え物の全部を不保存にして処分する（採らない・理由 古い）。
+fn drop_all(fx: &Fx, id: &str) -> Output {
+    fx.tz(&[
+        "dispose",
+        id,
+        "--verdict",
+        "採らない",
+        "--reason",
+        "古い",
+        "--drop",
+        "work/report.md",
+        "--drop",
+        "work/probe.py",
+    ])
+}
