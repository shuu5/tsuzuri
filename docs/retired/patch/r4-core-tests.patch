+                Gate::Unknown {
+                    why,
+                    ids: ids.clone(),
+                    digest: d.clone(),
+                },
+            ),
+        ];
+        for (head, gate) in gates {
+            let text = OUTPUT(&gate).unwrap_or_else(|| panic!("{gate:?} の答え"));
