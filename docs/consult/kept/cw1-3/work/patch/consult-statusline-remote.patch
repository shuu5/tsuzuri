+#[test]
+fn cwarg_audit_refuses_remote_control_mismatch() {
+    let fx = fixture();
+    let talk = launch(&fx["talk"]["inputs"]);
+    let ask = launch(&fx["ask"]["inputs"]);
+    assert_eq!(argv(&talk).get(1..3), Some(&["--remote-control".to_string(), "consult-cw3".to_string()][..]));
+    assert!(!argv(&ask).iter().any(|a| a == "--remote-control"));
+    let mut ask_rc = argv(&ask);
+    ask_rc.insert(3, "consult-cw4".into());
+    ask_rc.insert(3, "--remote-control".into());
+    assert_eq!(audit(&ask_rc, &ask), ["--remote-control"]);
+    let talk_rc: Vec<String> = argv(&talk)
+        .into_iter()
+        .filter(|x| x != "--remote-control")
+        .collect();
+    assert_eq!(audit(&talk_rc, &talk), ["--remote-control"]);
+    let other: Vec<String> = argv(&talk)
+        .into_iter()
+        .enumerate()
+        .map(|(i, x)| if i == 2 { "consult-cw9".to_string() } else { x })
+        .collect();
+    assert_eq!(audit(&other, &talk), ["--remote-control"]);
+    let set = settings(&talk);
+    assert_eq!(set["statusLine"], json!({"type": "command", "command": "/T consult statusline"}));
+}
