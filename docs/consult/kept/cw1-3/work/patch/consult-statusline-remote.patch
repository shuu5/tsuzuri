--- a/crates/tsuzuri-boundary/src/consult/statusline.rs	1970-01-01 09:00:00.000000000 +0900
+++ b/crates/tsuzuri-boundary/src/consult/statusline.rs	2026-10-05 09:24:51.958300114 +0900
@@ -0,0 +1,41 @@
+//! tz consult statusline（行 cs-statusline の案・窓の status line の口・判断の記録 ADR-29 決定 (7) の設定の statusLine）。
+//! Claude Code が status line の命令として撃つ（引数は取らない・stdin に session の JSON）。作業場は cwd（窓の控えを読む）。
+//! 窓の控え・findings/ の所見の数・bundle/digest の要約値・stdin の context の割合を中核の `status::render` で 1 行にして
+//! 標準出力に出す。読むだけで何も書かない。読めない物は欄を空にして落ちない（status line は席の目であって門でない）。
+//! 席の口でないので窓の守り（`SEAT_VERBS`）は通す。
+
+use std::io::Read;
+
+use tsuzuri_core::consult::status::{context_percent, render};
+
+use super::{FAIL, findings, read_window};
+use crate::out::{emit, emit_err};
+
+/// tz consult statusline の残りの引数を受けて終了 code を返す。
+pub fn run(rest: &[&str]) -> u8 {
+    if !rest.is_empty() {
+        emit_err("tz consult statusline: 引数を取らない");
+        return FAIL;
+    }
+    let mut input = String::new();
+    // stdin が無い・読めない周は context の欄を出さないだけ。
+    if std::io::stdin().read_to_string(&mut input).is_err() {
+        input.clear();
+    }
+    let ws = std::env::current_dir().ok();
+    let window = ws.as_deref().and_then(read_window);
+    let count = match (&ws, &window) {
+        (Some(ws), Some(w)) => Some(findings(ws, w.id).len()),
+        _ => None,
+    };
+    let digest = ws
+        .as_deref()
+        .and_then(|ws| std::fs::read_to_string(ws.join("bundle/digest")).ok());
+    emit(&render(
+        window.as_ref(),
+        count,
+        digest.as_deref(),
+        context_percent(&input),
+    ));
+    0
+}
