diff -ruN tz-build-pristine/crates/tsuzuri-core/src/consult/status.rs tz-build/crates/tsuzuri-core/src/consult/status.rs
--- a/crates/tsuzuri-core/src/consult/status.rs	1970-01-01 09:00:00.000000000 +0900
+++ b/crates/tsuzuri-core/src/consult/status.rs	2026-10-05 09:24:51.958300114 +0900
@@ -0,0 +1,62 @@
+//! 窓の status line の字（行 cs-statusline の案・判断の記録 ADR-29 決定 (7) の設定に statusLine を足す）。
+//! 起動の口の settings と audit は `command` の 1 関数で status line の命令の字を持つ。Claude Code は status line の命令の
+//! stdin に session の JSON を渡すので、そこから context の使用の割合を読む（鍵は `context_window.used_percentage`・
+//! 無ければ出さない・ほかの鍵は読み飛ばす＝Claude Code の字は版で増えるので断らない）。窓の控えと所見の数と束の要約値と
+//! 合わせて 1 行の字にする。読むだけで何も書かない。
+
+use serde_json::Value;
+use tsuzuri_contract::consult::WindowFile;
+
+/// status line の口の名（tz consult の口・席の口でないので窓の守りは通す）。
+pub const VERB: &str = "statusline";
+
+/// 欄の区切り。
+pub const SEP: &str = " ｜ ";
+
+/// 束の要約値の頭の字の数（16 字の要約値を短く出す）。
+pub const DIGEST_HEAD: usize = 8;
+
+/// status line の命令の字（起動の口の settings と audit が同じ字を持つ）。
+pub fn command(tz: &str) -> String {
+    format!("{tz} consult {VERB}")
+}
+
+/// Claude Code が渡す session の JSON から context の使用の割合（0〜100 の整数）。鍵が無い・数でない・範囲の外は None。
+pub fn context_percent(text: &str) -> Option<u8> {
+    let value: Value = serde_json::from_str(text).ok()?;
+    let percent = value
+        .pointer("/context_window/used_percentage")?
+        .as_f64()?;
+    if !percent.is_finite() || !(0.0..=100.0).contains(&percent) {
+        return None;
+    }
+    u8::try_from(percent.round() as i64).ok()
+}
+
+/// 1 行の字（窓・題・model と念入りさ・所見の数・束の要約値の頭・context の割合。無い欄は出さない）。
+pub fn render(
+    window: Option<&WindowFile>,
+    findings: Option<usize>,
+    digest: Option<&str>,
+    percent: Option<u8>,
+) -> String {
+    let mut parts: Vec<String> = Vec::new();
+    match window {
+        Some(w) => {
+            parts.push(format!("窓 {}", w.id));
+            parts.push(format!("題 {}", w.topic.as_deref().unwrap_or("なし")));
+            parts.push(format!("{}・{}", w.model, w.effort));
+        }
+        None => parts.push("窓 ?".to_string()),
+    }
+    if let Some(n) = findings {
+        parts.push(format!("所見 {n}"));
+    }
+    if let Some(d) = digest.map(str::trim).filter(|d| !d.is_empty()) {
+        parts.push(format!("束 {}", d.get(..DIGEST_HEAD).unwrap_or(d)));
+    }
+    if let Some(p) = percent {
+        parts.push(format!("文脈 {p}%"));
+    }
+    parts.join(SEP)
+}
