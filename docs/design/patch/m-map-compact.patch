-        let loose = loose.iter().map(|t| tag_view(t, mode)).collect_view();
-        view! { <div class="cards7">{arts}{loose}</div> }.into_any()
-    }
-
-    fn cards_view(
-        cards: Cards,
-        band: Band,
-        mode: impl Fn() -> Mode + Copy + Send + Sync + 'static,
