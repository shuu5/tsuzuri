-    let mut pair = None;
-    if let Some((from, to)) = q.pair {
-        let hit = pair_ends(doc, from, to);
-        nodes.retain(|n| hit.contains(n.id.as_str()));
-        pair = Some(PairNote {
-            from,
-            to,
-            count: nodes.len(),
-        });
-    }
-    if let Some(band) = q.band {
-        nodes.retain(|n| band_of(n.kind) == band);
