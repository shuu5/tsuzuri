-/// 0 件の箱の数の横の語の鍵（SRS は何が 0 本か・pipeline は何が 0 件か・ほかは帯の鍵）。
-pub fn zero_key(band: Band) -> &'static str {
-    match band {
-        Band::Srs => kind_key(NodeKind::Req),
-        Band::Pipeline => "run",
-        _ => band.key(),
-    }
-}
