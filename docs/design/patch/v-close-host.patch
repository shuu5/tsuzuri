+        run: id,
+        bead: &resolved.bead,
+        repo: &resolved.repo,
+        state_dir: &resolved.state_dir,
+        contract: &resolved.contract,
+        pr_cmd: None,
+        lens: &LensSource::Absent,
+        limits,
+        runner: None,
+        retries: 0,
+        land_wait_s: 0,
+        ci_wait_s,
+        ci_poll_s,
+        bd,
+        approved: resolved.approved,
