+/// [`terminal_input`]）。
+fn settled_entry<'a>(
+    args: &'a [String],
+    (id, manifest, policy): (&'a str, &Manifest, LockPolicy),
+    resolved: &'a Resolved,
+) -> Result<Land<'a>, Outcome> {
