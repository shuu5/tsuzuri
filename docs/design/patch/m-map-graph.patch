-            s: s0,
-            tx: 35.0,
-            ty: -15.0
-        }
-    );
-    assert_eq!(
-        Zoom::initial(s0),
-        Zoom {
-            s: s0,
-            tx: 0.0,
-            ty: 0.0
-        }
-    );
-    assert!(!graph::dragged(3.0, 0.0));
-    assert!(!graph::dragged(0.0, 4.0));
-    assert!(graph::dragged(3.0, 3.0));
