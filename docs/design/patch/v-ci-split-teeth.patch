+/// 字の列が text の中にちょうど 1 度ずつ、この順で在る。
+fn in_order(text: &str, order: &[&str]) {
+    let at: Vec<usize> = order
+        .iter()
+        .map(|s| {
+            assert_eq!(text.matches(s).count(), 1, "{s}");
+            text.find(s).expect(s)
+        })
+        .collect();
+    assert!(
