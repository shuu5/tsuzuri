+            assert!(git_ok(&repo, &["checkout", "--", "crates"]), "{patch}");
+            let text = String::from_utf8_lossy(&diff);
+            made.push(((*patch).to_owned(), if *broken { text.replacen("\n l", "\n x", 1) } else { text.into_owned() }.into_bytes()));
+        }
