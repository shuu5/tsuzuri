+        assert!(
+            err(&o).ends_with("（読める形に直してから起こし直す）\n"),
+            "{}",
+            err(&o)
+        );
+        assert!(fx.written().is_empty() && fx.calls("tmux.log").is_empty());
+        assert!(!Path::new(&private_tmp(&l.workspace)).exists());
+    }
+    assert_eq!(rc(&fx.tz(&["consult", "launch", "cw1"])), 0);
+    clear_tmp(&l);
+}
