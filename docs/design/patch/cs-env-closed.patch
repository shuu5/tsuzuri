+/// 席の環境の番兵（窓に渡さない名と、窓では中核の値に替わる窓の id と私用の temp・行 cs-env-closed）。
+const SEAT_CANARIES: [(&str, &str); 7] = [
+    ("TERM", "seat-term"),
+    ("CLAUDECODE", "1"),
+    ("CLAUDE_CODE_MESSAGING_TOKEN", "seat-token"),
+    ("SSH_AUTH_SOCK", "/seat/agent"),
+    ("USER", "seat"),
