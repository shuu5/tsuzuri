+/// 窓の環境の組（`TALK_ENV` と `BASE_ENV` の順・窓の id と私用の temp は `env` の値・ほかは `seat` が返す席の値・値の無い名は置かない）。
+/// 問う窓の子はこの組だけを持ち、話す窓は tmux の `-e` でこの組を渡して `keep_only` で包む。
+pub fn window_env(
+    l: &Launch,
+    seat: impl Fn(&str) -> Option<String>,
+) -> Vec<(&'static str, String)> {
+    let own = env(l);
+    TALK_ENV
+        .into_iter()
+        .chain(BASE_ENV)
+        .filter_map(|name| {
+            own.iter()
+                .find(|(n, _)| *n == name)
+                .map(|(_, v)| v.clone())
+                .or_else(|| seat(name))
+                .map(|v| (name, v))
+        })
+        .collect()
