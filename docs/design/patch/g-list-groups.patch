diff --git a/crates/tsuzuri-surface/src/project/ledger.rs b/crates/tsuzuri-surface/src/project/ledger.rs
index f2c5cfd8ded0cdd96e10eea08f030b5f02fea387..0087605f90afa911ce07b1dfcb1a7614985fbea3 100644
--- a/crates/tsuzuri-surface/src/project/ledger.rs
+++ b/crates/tsuzuri-surface/src/project/ledger.rs
@@ -3,9 +3,9 @@
