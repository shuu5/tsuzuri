+const REVIEW_FAIL: &str = r#"{"schema":1,"run":"fx-v.1-20261001T000000Z","verdict":"FAIL","evidence":"節の字と done の字が違う","kind":"literal-mismatch","at":"§3,行 c","ts":"2026-10-01T00:00:50Z"}"#;
