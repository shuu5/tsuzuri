+                count("constitution", 0),
+                count("delete", 0),
+                count("stdlib", 0),
+                count("native", 0),
+                count("yagni", 0),
+                count("shrink", 2),
+            ]),
+            at: Some(1790817570),
+        })
+    );
+}
