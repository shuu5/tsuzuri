+pub fn with_verdicts(
+    mut doc: RunsDoc,
+    gate: impl Fn(&str) -> Option<String>,
+    review: impl Fn(&str) -> Option<String>,
+) -> RunsDoc {
+    if let Reading::Known(lines) = &mut doc.runs {
+        for line in lines {
+            line.gate = gate(&line.run).map_or(Reading::Unknown, |body| gate_of(&body));
