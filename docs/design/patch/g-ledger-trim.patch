+    for kind in [
+        ChangeKind::Seat,
+        ChangeKind::Design,
+        ChangeKind::Account,
+        ChangeKind::Notice,
+    ] {
+        assert!(!reloads(FACTS_PATH, &[kind]), "{kind:?}");
+        assert!(!reloads(case::PATH, &[kind]), "{kind:?}");
+    }
+    for path in [FACTS_PATH, case::PATH] {
+        assert_eq!(
