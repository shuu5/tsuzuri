+    for want in [
+        "metrics.with(|f| stats(f).ok().map(|s| Unref::of(&s)))",
+        "let partial = u.partial().then(|| state_icon(UNKNOWN));",
+        "<span class=unref_chip(u.count)>{u.text()}</span>\n                    {partial}\n                    <span class=\"lchips\">{kinds}</span>",
