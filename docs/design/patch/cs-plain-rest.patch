+        git(
+            &repo,
+            &["config", "scribe2.statedir", state.to_str().unwrap()],
+        );
+        git(
+            &repo,
+            &["config", "tsuzuri.draftsdir", drafts.to_str().unwrap()],
+        );
+        let r = root.display().to_string();
