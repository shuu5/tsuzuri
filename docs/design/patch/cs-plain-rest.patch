+pub fn odd(ws: &Path, rel: &str) -> Option<String> {
+    match walk(ws, rel).map(fs::symlink_metadata) {
+        Err(e) if e.kind() == io::ErrorKind::NotFound => None,
+        Err(e) => Some(e.to_string()),
+        Ok(Err(_)) => None,
+        Ok(Ok(m)) => (!m.file_type().is_file()).then(|| NOT_PLAIN.to_string()),
+    }
