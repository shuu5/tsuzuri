+/// 相対 path `rel` の段の列（空の段・`.`・`..` を断る＝作業場の外へ出ない）。
+fn steps(rel: &str) -> io::Result<Vec<&str>> {
+    let parts: Vec<&str> = rel.split('/').collect();
+    if parts
+        .iter()
+        .any(|p| p.is_empty() || *p == "." || *p == "..")
+    {
+        return Err(io::Error::other(NOT_UNDER));
+    }
+    Ok(parts)
+}
