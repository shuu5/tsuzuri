+/// `f` を別の thread で撃ち、5 秒の内に返した値（fifo で止まれば落ちる）。
+fn within<T: Send + 'static>(f: impl FnOnce() -> T + Send + 'static) -> T {
+    let (tx, rx) = mpsc::channel();
+    thread::spawn(move || tx.send(f()).unwrap());
+    rx.recv_timeout(Duration::from_secs(5))
+        .expect("5 秒の内に返らない")
+}
