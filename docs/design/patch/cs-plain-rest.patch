+pub fn odd_dir(ws: &Path, rel: &str) -> Option<String> {
+    match steps(rel).and_then(|dirs| dir_path(ws, &dirs)) {
+        Err(e) if e.kind() == io::ErrorKind::NotFound => None,
+        Err(e) => Some(e.to_string()),
+        Ok(_) => None,
+    }
+}
