+        fx.put(".consult/proc-1.json", &wire::encode(&mark(1)).unwrap());
+        fx.put("findings/cw1-1.json", &wire::encode(&finding()).unwrap());
+        fx.put("work/report.md", "調べのレポート\n");
+        fx.put("work/probe.py", "print(1)\n");
