+/// 作業場からの相対 `rel` の普通の file を `bytes` に書き替える（`create_plain` で開いて全部を書く）。
+pub fn write_plain(ws: &Path, rel: &str, bytes: &[u8]) -> io::Result<()> {
+    create_plain(ws, rel)?.write_all(bytes)
+}
