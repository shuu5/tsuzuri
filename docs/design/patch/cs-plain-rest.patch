+fn dir_path(ws: &Path, dirs: &[&str]) -> io::Result<PathBuf> {
+    let mut path = ws.to_path_buf();
+    for dir in std::iter::once("").chain(dirs.iter().copied()) {
+        if !dir.is_empty() {
+            path.push(dir);
+        }
+        if !fs::symlink_metadata(&path)?.file_type().is_dir() {
+            return Err(io::Error::other(MID));
+        }
+    }
+    Ok(path)
+}
