+/// 作業場 `ws` からの相対 `rel` の path（`steps` と `dir_path` の照らしの後・file 自身は見ない）。
+fn walk(ws: &Path, rel: &str) -> io::Result<PathBuf> {
+    let parts = steps(rel)?;
+    let (name, dirs) = parts
+        .split_last()
+        .ok_or_else(|| io::Error::other(NOT_UNDER))?;
+    Ok(dir_path(ws, dirs)?.join(name))
