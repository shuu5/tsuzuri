+    assert_eq!(memory(&MEMINFO.replace("SwapFree", "SwapGone")), None);
+    assert_eq!(sectors_written(STAT), Some(89_003_451_946));
+    assert_eq!(sectors_written("1 2 3 4 5 6"), None);
+}
