+#[test]
+fn bvlc_unknown_phase_is_unmapped() {
+    let log = events(&[("lc.1", "RunStage", Some("Spawned"), "")]);
+    for parts in [
+        running("lc.1", "run-new-word"),
+        vec![contract("lc.1", "contract-parked", None, &[run_id("lc.1")])],
+    ] {
+        let b = board_with_cases(&ledger(), &log, &doc(parts), NOW);
