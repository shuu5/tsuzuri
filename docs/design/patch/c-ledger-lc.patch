+    let b = board_with_cases(&ledger(), "", &parked, NOW);
+    assert_eq!(b.board.cards, Reading::Unknown, "event log が読めない");
+    let b = board_with_cases(&ledger(), &log, &parked, NOW);
+    assert_eq!(
+        row(&b, "lc.4"),
+        (Stage::Queued, None, None),
+        "走行の無い札は台帳の割り"
+    );
+}
