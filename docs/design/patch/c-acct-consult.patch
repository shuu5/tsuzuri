+/// 台帳の字の相談の開きと閉じの行（台帳の順・字が bead の配列として読めなければ None）。
+fn consult_lines(ledger: &str) -> Option<Vec<Line>> {
+    let beads: Vec<NotesOnly> = serde_json::from_str(ledger).ok()?;
+    Some(
+        beads
+            .iter()
+            .filter_map(|b| b.notes.as_deref())
