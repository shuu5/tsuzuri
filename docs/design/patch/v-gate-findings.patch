+/// 偽 lens の判定の行（PASS・`findings` と `at` を指定・母集団は 0 でない）。
+fn vgfind_body(findings: &str, at: &str) -> String {
+    format!("{{\"verdict\":\"PASS\",\"evidence\":\"lens-saw-k8\",\"findings\":\"{findings}\",\"population\":\"files:1,lines:4\",\"at\":\"{at}\"}}")
