+fn open(by: By, opened: bool, again: bool) -> Line {
+    Line::Open {
+        window: win("cw3"),
+        form: Form::Talk,
+        topic: None,
+        by,
+        model: "fable".into(),
+        effort: "xhigh".into(),
+        opened,
+        again,
+        at: "20261003T1412Z".into(),
+    }
