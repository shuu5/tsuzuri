+    let o = fx.tz(&["consult", "bundle", "cw1"]);
+    assert_eq!((rc(&o), out(&o)), (0, format!("束 {want}\n")));
+    let newer = LEDGER.replace("問いの本文", "替えた本文");
+    fx.ledger(&newer);
+    let o = fx.tz(&["consult", "bundle", "cw1"]);
