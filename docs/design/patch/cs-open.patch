diff --git a/crates/tsuzuri-boundary/src/main.rs b/crates/tsuzuri-boundary/src/main.rs
index 4e75c9a282331f02dad798aaaeb2d49b5249e142..63b6b6ee19b1ae05ea13227be4020d6c1aba28fd 100644
