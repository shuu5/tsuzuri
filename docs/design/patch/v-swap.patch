+        let out = run_update(&built);
+        assert_eq!(out.status.code(), Some(i32::from(RC_OK)), "{label}: 組む: {}", stderr_text(&out));
+        assert_eq!(built.installs().len(), 1, "{label}: event 1 件");
+    }
+}
