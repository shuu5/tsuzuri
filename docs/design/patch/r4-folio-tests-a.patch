+                    j += 1;
+                }
+                value = s[v0..j].to_string();
+                j += 1;
+            } else {
+                let v0 = j;
+                while j < b.len() && !b[j].is_ascii_whitespace() && b[j] != b'>' {
+                    j += 1;
+                }
+                value = s[v0..j].to_string();
+            }
+        }
+        attrs.push((name, value));
