+    let timer = read_root("xtask/systemd/tsuzuri-daily.timer");
+    let body = |text: &str| -> Vec<String> {
+        text.lines()
+            .map(str::trim)
+            .filter(|l| !l.is_empty() && !l.starts_with('#'))
