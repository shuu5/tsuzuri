+        CHECKOUT,
+        ["checkout", "-q", "--detach", "refs/remotes/origin/main"]
+    );
+    assert_eq!(NICE, ("nice", &["-n", "10"][..]));
+    assert_eq!(CHECK, ["run", "-q", "-p", "xtask", "--", "check"]);
