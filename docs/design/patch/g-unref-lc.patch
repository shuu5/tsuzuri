+/// 局面の出力の口の本文の memo と問いの部品を id の表（局面の語と手番の語）にする（読めない・まだ読んでいない・
+/// 出力が無いは None）。
+pub fn phases(fetched: &Fetched) -> Option<BTreeMap<String, (String, String)>> {
+    let Fetched::Body(text) = fetched else {
+        return None;
+    };
+    match wire::decode::<CaseDoc>(text) {
+        Ok(CaseDoc {
+            parts: Reading::Known(parts),
+            ..
+        }) => Some(
+            parts
+                .into_iter()
+                .filter(|p| matches!(p.part.as_str(), "memo" | "question"))
+                .map(|p| (p.id, (p.phase, p.turn)))
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+/// memo と問いの行に局面と手番の平易な字を置く（表に id が無い・表が読めない行は「まだ分からない」・ほかの行は None のまま）。
+pub fn with_phases(groups: Vec<Lgroup>, cases: &Fetched) -> Vec<Lgroup> {
+    let table = phases(cases);
+    groups
+        .into_iter()
+        .map(|mut g| {
+            for r in &mut g.rows {
+                if matches!(r.kind, NodeKind::Memo | NodeKind::Question) {
+                    let found = table.as_ref().and_then(|t| t.get(&r.id));
+                    r.phase = Some(found.map_or_else(
+                        || label(UNKNOWN_WORD_KEY),
+                        |(phase, turn)| phase_text(phase, turn),
+                    ));
+                }
+            }
+            g
+        })
+        .collect()
+}
+
+/// 見出しの未反映の数の字と title の字（数は台帳の block の未反映の数の字に手番の席の字を添える・title は種類ごとの
+/// 数と局面の平易な字・数の分からない種類は「まだ分からない」）。
+pub fn unref_head(s: &LedgerStats) -> (String, String) {
+    let unref = Unref {
+        count: s.unreflected,
+        unknown: s
+            .unreflected_unknown
+            .iter()
+            .map(|k| kind_name(*k))
+            .collect(),
+    };
+    let text = format!(
+        "{} {} · {}",
+        label("l_unref"),
+        unref.text(),
+        plain_word(TURN_KEY, "seat")
+    );
+    let title = UnreflectedKind::ALL
+        .iter()
+        .map(|k| {
+            let n = s
+                .unreflected_kinds
+                .iter()
+                .find(|c| c.kind == *k)
+                .map_or_else(|| label(UNKNOWN_WORD_KEY), |c| c.count.to_string());
+            format!("{} {n}（{}）", kind_label(*k), kind_phase_text(*k))
+        })
+        .collect::<Vec<_>>()
+        .join(" / ");
+    (text, title)
+}
