+//! 便の木の並び（判断の記録 ADR-35 の形 c・宣言の任意 key `build-lanes` を名乗った repo の便だけ）。
+//!
+//! 並びの木は `<repo>/.worktrees/<NAME>/lane/<n>`（path を固定した worktree）で、木の中の target を便から便へ使い回す。
+//! 便の木の path（[`worktree_path`]）は並びの木を指す相対の symlink で、path を読む呼び手は替えずにそのまま並びの木を読む。
+//! 印 `lane/<n>.run` は最後にその木を使った便の id で、その便の path の symlink が在る間は便が並びを持つ（ほかの便に渡さない）。
+//! 中身の替えは `git checkout -f` と `git clean -ffdx -e /target` で、git は中身の替わる file だけを書くので、cargo は
+//! 中身の替わった crate だけを組み直す（中身の替わらない file の mtime は前の組みより古いまま残る）。
+
+use super::land::{retired_path, WorktreeCheck};
+use super::{branch_name, git_line, git_ok, worktree_path, worktrees_dir};
+use crate::fleet::store::{self, LockPolicy};
+use std::path::{Path, PathBuf};
+
+/// 並びの木を集める dir の名（`worktrees_dir` の直下）。
+const LANE_DIR: &str = "lane";
+
+/// 印の file の拡張子（`<n>.run`）。
+const MARK_EXT: &str = "run";
+
+/// 並びを取る lock の名（並びの dir の直下・repo ごとに 1 本）。
+const LOCK: &str = "lane.lock";
+
+/// 中身の替えで消さない dir（木の中の組みの置き場）。
+const KEEP: &str = "/target";
+
+/// 握った lock（`Drop` で外す・外せない lock は次の周が所有者の生死で回収する）。
+struct Held(PathBuf);
+
+impl Drop for Held {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.0);
+    }
+}
+
+/// 並びの木を集める dir。
+fn lanes_dir(repo: &Path) -> PathBuf {
+    worktrees_dir(repo).join(LANE_DIR)
+}
+
+/// 並び `n` の木。
+fn lane_path(repo: &Path, n: usize) -> PathBuf {
+    lanes_dir(repo).join(n.to_string())
+}
+
+/// 並び `n` の印（最後にその木を使った便の id）。
+fn mark_path(repo: &Path, n: usize) -> PathBuf {
+    lanes_dir(repo).join(format!("{n}.{MARK_EXT}"))
+}
+
+/// 名指した sha の宣言が便の木を並びで使い回すか（`build-lanes = true` の周だけ真）。
+pub(crate) fn declared(repo: &Path, sha: &str) -> bool {
+    super::declaration::build_lanes_at(repo, sha)
+}
+
+/// 便が持つ並びの木（便の path が並びの木を指す symlink の周だけ・ほかは `None`）。
+pub(crate) fn held_lane(repo: &Path, run: &str) -> Option<PathBuf> {
+    let link = std::fs::read_link(worktree_path(repo, run)).ok()?;
+    let lane = worktrees_dir(repo).join(link);
+    (lane.parent() == Some(lanes_dir(repo).as_path())).then_some(lane)
+}
+
+/// 並び `n` を便が持っているか（印の便の path が並び `n` の木を指す）。
+fn is_held(repo: &Path, n: usize) -> bool {
+    std::fs::read_to_string(mark_path(repo, n))
+        .ok()
+        .and_then(|run| held_lane(repo, run.trim()))
+        .is_some_and(|lane| lane == lane_path(repo, n))
+}
+
+/// 名乗った repo の便の初回の木を並びから用意し、便の path（並びの木を指す symlink）を返す。
+///
+/// 持たれていない並びのうち木の在る最も小さい番号を使い回し、無ければ木の無い最も小さい番号に新しく切る。使い回す木は中身を
+/// base に替え、clean で HEAD が base でない周は今の退役の形（`retired/<前の便>` への move）で退かせてから新しく切る。
+pub(crate) fn take(repo: &Path, run: &str, base: &str, policy: LockPolicy) -> Result<PathBuf, String> {
+    let (n, prev) = claim(repo, run, policy)?;
+    let lane = lane_path(repo, n);
+    let path = lane.display().to_string();
+    if let Some(prev) = prev {
+        if switch(&lane, run, base) {
+            return Ok(worktree_path(repo, run));
+        }
+        let dest = retired_path(repo, &prev);
+        let to = dest.display().to_string();
+        let moved = dest.parent().is_some_and(|parent| std::fs::create_dir_all(parent).is_ok())
+            && git_ok(repo, &["worktree", "move", &path, &to]);
+        if !moved {
+            return Err(format!("並び {path} を替えられず {to} へも移せない"));
+        }
+    }
+    let branch = branch_name(run);
+    if !git_ok(repo, &["worktree", "add", "-b", &branch, &path, base]) {
+        return Err(format!("並び {path} を切れない（branch {branch}）"));
+    }
+    Ok(worktree_path(repo, run))
+}
+
+/// lock の中で並びを 1 つ選び、印を便の id に書き、便の path に並びの木を指す symlink を置く。
+/// 返すのは並びの番号と、使い回す周の前の便の id（新しく切る周は `None`）。
+fn claim(repo: &Path, run: &str, policy: LockPolicy) -> Result<(usize, Option<String>), String> {
+    let dir = lanes_dir(repo);
+    std::fs::create_dir_all(&dir).map_err(|err| format!("{} を作れない: {err}", dir.display()))?;
+    let lock = dir.join(LOCK);
+    store::acquire_with(&lock, policy, store::Reclaim::DeadOnly).map_err(|_| format!("{} を取れない", lock.display()))?;
+    let _held = Held(lock);
+    let link = worktree_path(repo, run);
+    if std::fs::symlink_metadata(&link).is_ok() {
+        return Err(format!("{} は既に在る", link.display()));
+    }
+    let mut lanes: Vec<usize> = std::fs::read_dir(&dir)
+        .map_err(|err| format!("{} を読めない: {err}", dir.display()))?
+        .flatten()
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
+        .filter_map(|entry| entry.file_name().to_str().and_then(|name| name.parse().ok()))
+        .collect();
+    lanes.sort_unstable();
+    let reuse = lanes.iter().copied().find(|n| !is_held(repo, *n));
+    let n = reuse.unwrap_or_else(|| (0..=lanes.len()).find(|n| !lanes.contains(n)).unwrap_or(lanes.len()));
+    let prev = reuse.map(|n| std::fs::read_to_string(mark_path(repo, n)).unwrap_or_default().trim().to_owned());
+    let mark = mark_path(repo, n);
+    std::fs::write(&mark, format!("{run}\n")).map_err(|err| format!("{} を書けない: {err}", mark.display()))?;
+    std::os::unix::fs::symlink(Path::new(LANE_DIR).join(n.to_string()), &link)
+        .map_err(|err| format!("{} を置けない: {err}", link.display()))?;
+    Ok((n, prev))
+}
+
+/// 並びの木の中身を base に替える（git は中身の替わる file だけを書く・未追跡と無視の file は target の外を全部消す）。
+/// clean で HEAD が base の周だけ branch `<NAME>/<run>` を付けて真。
+fn switch(lane: &Path, run: &str, base: &str) -> bool {
+    // index の stat を木に合わせてから替える（stat の古い file を中身が同じでも書き直さない・rc は替わった file の有無で読まない）。
+    let _ = git_ok(lane, &["update-index", "-q", "--refresh"]);
+    git_ok(lane, &["checkout", "-q", "-f", "--detach", base])
+        && git_ok(lane, &["clean", "-q", "-ffdx", "-e", KEEP])
+        && WorktreeCheck::judge(lane).is_clean()
+        && git_line(lane, &["rev-parse", "HEAD"]) == git_line(lane, &["rev-parse", &format!("{base}^{{commit}}")])
+        && git_ok(lane, &["checkout", "-q", "-B", &branch_name(run)])
+}
+
+/// 便が並びを返す（退役の move の代わり・判断の記録 ADR-35）。clean な木は並びに残し（印を書き直して新しさを今にし、
+/// 便の path の symlink を外す）、clean でない木は今の退役の形のまま `retired/<run>` へ move して印と symlink を外す。
+/// 失敗は stderr 行の列で返す（[`super::land::retire_worktree`] と同じ形）。
+pub(crate) fn give_back(repo: &Path, run: &str, lane: &Path) -> Vec<String> {
+    let link = worktree_path(repo, run);
+    let Some(n) = lane.file_name().and_then(|name| name.to_str()).and_then(|name| name.parse::<usize>().ok()) else {
+        return vec![format!("pipe: {} は並びの木でない", lane.display())];
+    };
+    if WorktreeCheck::judge(lane).is_clean() {
+        if std::fs::write(mark_path(repo, n), format!("{run}\n")).is_ok() && std::fs::remove_file(&link).is_ok() {
+            return Vec::new();
+        }
+        return vec![format!("pipe: 並び {} を返せなかった", lane.display())];
+    }
+    let dest = retired_path(repo, run);
+    let (from, to) = (lane.display().to_string(), dest.display().to_string());
+    let moved = dest.parent().is_some_and(|parent| std::fs::create_dir_all(parent).is_ok())
+        && git_ok(repo, &["worktree", "move", &from, &to]);
+    if moved && std::fs::remove_file(&link).is_ok() && std::fs::remove_file(mark_path(repo, n)).is_ok() {
+        return Vec::new();
+    }
+    vec![format!("pipe: {from} を {to} へ移せなかった")]
+}
+
