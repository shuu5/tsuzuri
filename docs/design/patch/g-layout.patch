+  .one > .pane:has(#pipe) { order: -1; }
+  .one > .pane > .panel { flex: none; overflow: visible; }
+  #pipe .board { display: none; }
+  #pipe .ptiles { display: block; }
+}
+/* スマホの段の tile（行 g-layout・見本 board-v2 の .mt・.tile・.mlist）: 5 つの段の数と色・開いた段の札の並び */
+.ptiles { display: none; }
+.ptrow { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; padding: 0 0 8px; }
+.ptile { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 56px; border: 1px solid var(--line); border-top: 4px solid var(--sc, var(--s-wait)); border-radius: 8px; background: var(--panel); color: var(--sc, var(--s-wait)); font: inherit; cursor: pointer; padding: 2px; }
+.ptile.c-block, .ptile.c-queue { --sc: var(--s-wait); } .ptile.c-run { --sc: var(--s-run); } .ptile.c-stop { --sc: var(--s-stop); } .ptile.c-land { --sc: var(--s-land); }
+.ptile .pt1 b { font-size: 17px; color: var(--ink); }
+.ptile small { font-size: 10.5px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
+.ptile.on { background: color-mix(in srgb, var(--sc) 10%, var(--panel)); border-color: var(--sc); box-shadow: 0 0 0 1px var(--sc); }
+.ptwarn { color: var(--st-limit); margin-left: 2px; }
