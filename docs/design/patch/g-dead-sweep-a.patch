-/// 宣言の字 `decl` から、次の 4 つの空白と閉じ波括弧だけの行までの本文（mod dom の中の fn）。
-fn body<'a>(dom: &'a str, decl: &str) -> &'a str {
-    let start = dom
-        .find(decl)
-        .unwrap_or_else(|| panic!("mod dom に {decl} が無い"));
-    let rest = &dom[start..];
-    let end = rest
-        .find("\n    }\n")
-        .unwrap_or_else(|| panic!("{decl} の閉じの行が無い"));
-    &rest[..end]
-}
