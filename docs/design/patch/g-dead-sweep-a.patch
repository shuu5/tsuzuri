-/// 字の列が `text` にこの順に在る（無ければどれが無いかで落ちる）。
-fn in_order(text: &str, words: &[&str], what: &str) {
-    let mut at = 0;
-    for w in words {
-        let i = text[at..]
-            .find(w)
-            .unwrap_or_else(|| panic!("{what} に {w} が並びの順に無い: {text}"));
-        at += i + w.len();
-    }
-}
